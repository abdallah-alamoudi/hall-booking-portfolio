{
  "name": "hall-booking-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,DASHBOARD -c green,blue \"npm run dev:api\" \"npm run dev:dashboard\"",
    "dev:api": "npm --workspace services/api run dev",
    "dev:dashboard": "npm --workspace apps/dashboard run dev",
    "build": "npm run build:contracts && npm run build:api && npm run build:dashboard",
    "build:contracts": "npm --workspace packages/contracts run build",
    "build:api": "npm --workspace services/api run build",
    "build:dashboard": "npm --workspace apps/dashboard run build",
    "db:reset": "npm --workspace services/api exec prisma migrate reset",
    "dev:mobile": "cd apps/mobile && fvm flutter run"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "source-map-support": "^0.5.21"
  },
  "dependencies": {
    "imurmurhash": "^0.1.4"
  }
}
